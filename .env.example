# VERIFAI - Environment Configuration
# IBM x Government of Kerala — KeralAI Hackathon 2026 (Challenge 3: Export Document Verification)

# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:8080

# Google Gemini API Key (Optional with automatic multi-key failover & rotation)
# If provided, VERIFAI queries Google Gemini (gemini-flash-lite-latest / gemini-flash-latest)
# Grounded in the 5 export documents, document lineage, and discrepancy consequence matrix.
# Get free keys at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_BACKUP_KEYS=
GEMINI_API_KEY_BACKUP1=
GEMINI_API_KEY_BACKUP2=
GEMINI_API_KEY_BACKUP3=

# Database Configuration (Optional)
# If left empty, VERIFAI automatically operates in resilient DEMO MODE
# with the pre-seeded in-memory store containing Cochin/Vizhinjam maritime export datasets.
# DATABASE_URL=postgresql://user:password@localhost:5432/verifai

# AI Assistant & Semantic Grounding (Alternative)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# OCR Provider Configuration (Optional)
# Options: "tesseract" (local OCR), "mock" (fast deterministic fallback)
OCR_PROVIDER=mock
TESSERACT_LANG=eng

# Export Document Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
