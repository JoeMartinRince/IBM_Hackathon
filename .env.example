# VERIFEX AI - Environment Configuration
# IBM x Government of Kerala — KeralAI Hackathon 2026 (Challenge 3: Export Document Verification)

# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:8080

# Database Configuration (Optional)
# If left empty, VERIFEX AI automatically operates in resilient DEMO MODE
# with the pre-seeded in-memory store containing Cochin/Vizhinjam maritime export datasets.
# DATABASE_URL=postgresql://user:password@localhost:5432/verifex

# AI Assistant & Semantic Grounding (Optional)
# Supported providers: "mock", "ollama", "gemini", "openai"
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=granite-3.2-8b-instruct

# OCR Provider Configuration (Optional)
# Options: "tesseract" (local OCR), "mock" (fast deterministic fallback)
OCR_PROVIDER=mock
TESSERACT_LANG=eng

# Export Document Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
